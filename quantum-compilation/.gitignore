*.kmb
*.kmx

# kickmix.so ships with the competition dataset; we depend on the PyPI wheel instead.
*.so

# Rendered circuit views -- regenerate with `vqcc diagram`.
*.flame.svg

.pytest_cache/
.ruff_cache/
