# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Data / model artefacts (regenerable)
*.parquet
*.ckpt
*.pt
.cache/
data/
# ...but touchstone ships its reference tables as tracked package data
!touchstone/src/touchstone/data/
!touchstone/src/touchstone/data/**

# Local scratch / staging for GPU-box runs — duplicates tracked inputs, not an artefact of record
materialhack/
# Nested worktrees: keep `git worktree add` under .claude/ from ever being committable
.claude/worktrees/

# tnf-binder local env
tnf-binder/.venv/
tnf-binder/.pytest_cache/

# W&B local run cache (runs live at wandb.ai/chaleong/tnf-conditional-binder)
wandb/

# pytest-cov writes this next to the package it measures
.coverage

# TfR1: large downloaded structures and generator output, regenerate instead
tfr1/data/*.cif
tfr1/data/targets/
# ...except the measured epitope table, which the submission is selected and reported against.
# The parent directories have to be re-included too -- git will not descend into an excluded
# directory to find a negated file -- and `targets/*` then re-excludes the structures beside it.
!tfr1/data/
tfr1/data/*
!tfr1/data/targets/
tfr1/data/targets/*
!tfr1/data/targets/hotspots.json
