# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# Data / model artefacts (regenerable)
*.parquet
*.ckpt
*.pt
.cache/
data/
# ...but touchstone ships its reference tables as tracked package data
!touchstone/src/touchstone/data/
!touchstone/src/touchstone/data/**
# ...and quantum-compilation commits the official verifiers' own reference outputs, which are
# what pin its cost model to the real metric
!quantum-compilation/tests/data/
!quantum-compilation/tests/data/**
# ...and pmhc commits the result tables its deliverables render from: the artifact page, the
# LaTeX report and the W&B report all claim every figure is read from a committed file, and that
# claim is only true if they are tracked. 22 KB.
!pmhc/data/
!pmhc/data/*.csv

# Local scratch / staging for GPU-box runs — duplicates tracked inputs, not an artefact of record
materialhack/
# Nested worktrees: keep `git worktree add` under .claude/ from ever being committable
.claude/worktrees/

# tnf-binder local env
tnf-binder/.venv/
tnf-binder/.pytest_cache/

# W&B local run cache (runs live at wandb.ai/chaleong/tnf-conditional-binder)
wandb/

# pytest-cov writes this next to the package it measures
.coverage

# pmhc: generator and verifier outputs, regenerable from the committed scripts
pmhc/gen_out/
pmhc/smoke*/
pmhc/fold_work*/
pmhc/cohort_poses/
pmhc/cofold_specs/
pmhc/cofold_out/
pmhc/cofold_*_out/
pmhc/logs/
pmhc/data/*.cif
pmhc/targets/
pmhc/cofold_wt_specs/

# LaTeX build products. The PDF is committed; everything else pdflatex writes is not.
*.aux
*.log
*.out
*.toc
*.synctex.gz
